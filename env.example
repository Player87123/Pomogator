# Токен сообщества (Настройки сообщества -> Работа с API -> Ключи доступа)
GROUP_TOKEN=your_group_token_here

# Через сколько часов после старта опроса слать напоминание не ответившим
REMINDER_HOURS=24

# Как часто (в минутах) бот проверяет, не пора ли слать напоминания
CHECK_INTERVAL_MINUTES=10

# (Необязательно) peer_id беседы, куда нужно один раз автоматически залить
# данные детей/родителей из seed_data.py при первом запуске бота.
# Альтернатива ручному запуску seed_import.py. Оставьте пустым, если не нужно.
